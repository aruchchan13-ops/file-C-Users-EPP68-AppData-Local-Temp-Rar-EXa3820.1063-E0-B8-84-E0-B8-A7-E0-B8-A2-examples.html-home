# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5     # or claude-sonnet-5-5 / claude-haiku-5-5 (cheaper)
# PORT=3000
# HOST=127.0.0.1                      # use 0.0.0.0 to open from your phone on the same Wi-Fi
# APP_PASSWORD=choose-a-password      # required when HOST=0.0.0.0
# DATA_DIR=./data                     # where lessons and uploaded files are stored
