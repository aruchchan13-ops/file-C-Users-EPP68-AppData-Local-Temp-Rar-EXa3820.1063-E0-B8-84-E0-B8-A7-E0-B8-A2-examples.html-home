{
  "name": "eyeready",
  "private": true,
  "version": "1.0.0",
  "description": "EyeReady — offline-first astronaut eye-health monitoring and preparedness PWA (NASA Space Apps Challenge 2026)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "NODE_PATH=$(npm root -g) node scripts/make-icons.mjs",
    "calibrate": "vitest run src/services/__tests__/demoCalibration.test.ts --reporter=verbose",
    "e2e": "NODE_PATH=$(npm root -g) node e2e/acceptance.mjs http://localhost:4173/"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "5.1.0",
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "axe-core": "^4.10.2",
    "fake-indexeddb": "6.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
